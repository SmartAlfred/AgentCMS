# Caddyfile for the AgentCMS production stack (#31; made to actually adapt in #37).
#
#   DOMAIN=localhost (the default)  -> self-signed certificate (Caddy's internal CA,
#                                      which it uses for `localhost` automatically)
#   DOMAIN=cms.example.com          -> automatic HTTPS via Let's Encrypt
#                                      (needs public DNS + ports 80/443)
#
# Proxies everything to api:8000 and adds security headers.  Embed CORS is applied
# by the API itself (app/api/embed/) from the comma-separated EMBED_ORIGINS; the
# matchers below let the edge short-circuit a preflight for the *same* list, which
# is why they are gated on it (#48: they used to match any OPTIONS request and
# reflect whatever Origin the caller sent, with credentials).
#
# CADDY_EMAIL is passed by compose for ACME contact but is not used here: Caddy's
# global `email` option cannot be made conditional and an empty value aborts config
# adaptation (which is exactly how this file failed to boot — see #37).
#
# One site block only: with DOMAIN=localhost the old "localhost fallback" block
# defined the same site twice, and Caddy refuses a duplicated matcher.

{
    # Admin API, used by the compose healthcheck
    admin :2019
}

{$DOMAIN:localhost} {
    reverse_proxy api:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
    }

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    # HSTS only on a real domain.  This must be a matcher line, not an entry in the
    # `header` block: `{$DOMAIN != "localhost"}` expanded to a field with no value.
    @hsts not host localhost
    header @hsts Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # --- embed CORS (#48) ----------------------------------------------------
    #
    # The API is the only authority for embed CORS: app/api/embed/routes.py
    # answers preflights on /embed/v1/* and reflects an Origin only when it is in
    # EMBED_ORIGINS (deny-all when that list is empty).  The two blocks below are a
    # short-circuit for browsers, and both are gated on that same allowlist, so the
    # edge can never assert a permission the operator denied.  They are also scoped
    # to /embed/*: a matcher on every path would hand an allowlisted origin
    # Access-Control-Allow-Credentials on the admin and dashboard responses too.
    #
    # EMBED_ORIGINS_REGEX is the pipe-joined, escaped form of the documented
    # comma-separated EMBED_ORIGINS; scripts/selfhost.sh derives it into .env at
    # deploy time (`make selfhost`).  Unset/empty expands to `^()$`, which no real
    # Origin matches -- so the documented `EMBED_ORIGINS=` deny-all default now
    # leaves the edge silent and the API's own deny-all answer reaches the caller
    # (before #48 the edge answered 204 + reflected ACAO for every origin).
    #
    # A deployed stack that skipped selfhost.sh has no EMBED_ORIGINS_REGEX: the
    # edge then simply stops short-circuiting, which is the fail-closed direction.
    # The derivation escapes `.` as `[.]` instead of `\.` and never emits a space,
    # so the spliced value cannot be mangled by Caddy's tokeniser, and
    # `https://a.com` cannot end up also matching `https://aXcom`.
    @embed_origin {
        path /embed/*
        header_regexp Origin ^({$EMBED_ORIGINS_REGEX})$
    }

    # One matcher name may be defined once — two `@embed_preflight` lines in the
    # same block were another hard adaptation failure.
    @embed_preflight {
        method OPTIONS
        header Access-Control-Request-Method *
        path /embed/*
        header_regexp Origin ^({$EMBED_ORIGINS_REGEX})$
    }
    handle @embed_preflight {
        header Access-Control-Allow-Origin "{header.Origin}"
        header Access-Control-Allow-Methods "GET, POST, OPTIONS"
        header Access-Control-Allow-Headers "Content-Type, Authorization"
        header Access-Control-Allow-Credentials "true"
        header Access-Control-Max-Age "86400"
        header Vary "Origin"
        respond 204
    }
    handle @embed_origin {
        header Access-Control-Allow-Origin "{header.Origin}"
        header Access-Control-Allow-Credentials "true"
        header Vary "Origin"
    }
}
