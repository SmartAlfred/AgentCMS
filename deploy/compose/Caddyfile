# Caddyfile for AgentCMS production deployment (#31).
# This file is used by the caddy service in docker-compose.prod.yml.
# 
# Behavior:
# - If DOMAIN is set to a real domain (e.g., cms.example.com) and CADDY_EMAIL is set:
#     → Automatic HTTPS via Let's Encrypt
# - If DOMAIN=localhost (default) or no CADDY_EMAIL:
#     → Self-signed certificates for local HTTPS (browser will warn)
# - Proxies all traffic to api:8000
# - Adds security headers
# - Configures CORS for embed origins (EMBED_ORIGINS env var)

{
    # Admin API for healthcheck
    admin :2019
    # Disable automatic HTTPS if using localhost without email
    {$CADDY_EMAIL:}
    local_certs
}

{$DOMAIN} {
    # Proxy to API
    reverse_proxy api:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
    }

    # Security headers
    header {
        # Prevent MIME type sniffing
        X-Content-Type-Options "nosniff"
        # Prevent clickjacking
        X-Frame-Options "SAMEORIGIN"
        # XSS protection (legacy but harmless)
        X-XSS-Protection "1; mode=block"
        # Referrer policy
        Referrer-Policy "strict-origin-when-cross-origin"
        # Permissions policy
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        # HSTS (only on real domains with valid certs)
        {$DOMAIN != "localhost"}
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    }

    # CORS for embed origins (configured via EMBED_ORIGINS env var)
    # Format: comma-separated list like "https://example.com,https://app.example.com"
    @embed_origin {
        header Origin {$EMBED_ORIGINS}
    }
    @embed_preflight method OPTIONS
    @embed_preflight header Access-Control-Request-Method *
    handle @embed_preflight {
        header Access-Control-Allow-Origin "{header.Origin}"
        header Access-Control-Allow-Methods "GET, POST, OPTIONS"
        header Access-Control-Allow-Headers "Content-Type, Authorization"
        header Access-Control-Allow-Credentials "true"
        header Access-Control-Max-Age "86400"
        respond 204
    }
    handle @embed_origin {
        header Access-Control-Allow-Origin "{header.Origin}"
        header Access-Control-Allow-Credentials "true"
        header Vary "Origin"
    }
}

# Local development fallback (when DOMAIN=localhost)
localhost {
    # Proxy to API
    reverse_proxy api:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
    }

    # Security headers
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    # CORS for embed origins
    @embed_origin {
        header Origin {$EMBED_ORIGINS}
    }
    @embed_preflight method OPTIONS
    handle @embed_preflight {
        header Access-Control-Allow-Origin "{header.Origin}"
        header Access-Control-Allow-Methods "GET, POST, OPTIONS"
        header Access-Control-Allow-Headers "Content-Type, Authorization"
        header Access-Control-Allow-Credentials "true"
        header Access-Control-Max-Age "86400"
        respond 204
    }
    handle @embed_origin {
        header Access-Control-Allow-Origin "{header.Origin}"
        header Access-Control-Allow-Credentials "true"
        header Vary "Origin"
    }
}