# ---------------------------------------------------------------------------
# AgentCMS Production Deployment Environment Variables
# Copy to .env and fill in values: cp deploy/.env.example .env
#
# In production (APP_ENV=production), the service refuses to boot if any
# variable marked [prod-required] is missing, or if any variable marked
# [dev-only default] is left at its development default value.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
# development | test | production
APP_ENV=production
# Human-readable service name, echoed by /healthz and the OpenAPI document.
APP_NAME=AgentCMS
# Version reported by /healthz and /openapi.json.
APP_VERSION=0.3.1
# Log level for the structured logger: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO
# Structured request logs: json (machine-readable) or text (readable).
LOG_FORMAT=json
# Serve GET /docs (Scalar), GET /redoc and GET /openapi.json.
DOCS_ENABLED=true
# Bind address for the API (inside container).
HOST=0.0.0.0
# Bind port for the API (inside container).
PORT=8000
# Comma-separated CORS origins for browser API clients. Empty = no CORS middleware.
CORS_ORIGINS=

# --- Security --------------------------------------------------------------
# SECRET_KEY signs session/token material. [prod-required] No working default
# in production: boot fails if it is missing, still the dev value, or < 32 chars.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-secret-change-me-please-000000000000
# Enable debug mode. Must be false when APP_ENV=production.
DEBUG=false

# --- Database --------------------------------------------------------------
# [prod-required] SQLAlchemy URL. The dev default matches `docker compose up db`.
DATABASE_URL=postgresql+psycopg://agentcms:agentcms@localhost:5432/agentcms
# Credentials consumed by compose.yml for the local Postgres container.
POSTGRES_USER=agentcms
POSTGRES_PASSWORD=changeme
POSTGRES_DB=agentcms
# Connection pool sizing.
DB_POOL_SIZE=5
# Seconds to wait for a connection from the pool before failing readyz.
DB_POOL_TIMEOUT=5
# Echo SQL to stdout (development only).
DB_ECHO=false

# --- Object Storage (S3-compatible; MinIO locally, S3/R2 in prod) ----------
# Used by the media/asset endpoints. Unset = media endpoints disabled.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=agentcms-media
S3_REGION=us-east-1
# Public base URL media URLs are built from.
S3_PUBLIC_BASE_URL=

# --- Content Defaults ------------------------------------------------------
# Slug of the demo site created by `make seed`.
DEFAULT_SITE_SLUG=blog
# auto | require_review — publish_mode of the demo site (create never publishes).
DEFAULT_PUBLISH_MODE=auto
# How many idempotency-key responses are retained, in hours.
IDEMPOTENCY_RETENTION_HOURS=24

# --- Public URL ------------------------------------------------------------
# Canonical public base URL for generated links (static export, embed, llms.txt).
# When unset, falls back to the request host (dynamic endpoints) or localhost (docs).
# Example: PUBLIC_BASE_URL=https://cms.example.com
PUBLIC_BASE_URL=

# --- Capability Links ------------------------------------------------------
# Default lifetime of a link minted without an explicit TTL, in minutes.
CAPABILITY_DEFAULT_TTL_MINUTES=60
# Hard ceiling on a requested link TTL, in days.
CAPABILITY_MAX_TTL_DAYS=30
# Requests allowed per capability link within the window below.
CAPABILITY_RATE_LIMIT_PER_LINK=30
# Sliding rate-limit window, in seconds.
CAPABILITY_RATE_LIMIT_WINDOW_SECONDS=60
# Refuse to mint more than this many live links per site.
CAPABILITY_MAX_LIVE_LINKS_PER_SITE=100

# --- Observability ---------------------------------------------------------
# Shared secret required on GET /metrics (admin gate). Empty = metrics are
# still available to authenticated admin tokens and loopback scrapers only.
METRICS_TOKEN=
# OTLP/HTTP endpoint for OpenTelemetry traces, e.g. http://jaeger:4318.
# Empty = tracing is soft-disabled (no export; the hot path stays cheap).
OTLP_ENDPOINT=
# OTel service.name reported by trace spans (/metrics and /v1/version too).
OTEL_SERVICE_NAME=agentcms
# Trace sampling ratio for ordinary requests (0.1 = 10%). Errors are always sampled.
TRACE_SAMPLE_RATIO=0.1
# Baked-in build metadata for /v1/version. Empty = resolved from git/files at runtime.
GIT_SHA=
BUILD_TIME=

# --- Backups & Restore Drill -----------------------------------------------
# Where nightly pg_dump backups are written:
#   file:///absolute/path  (local directory; also the restore-drill default)
#   s3://bucket/prefix     (S3-compatible object storage)
# Empty = backups disabled.
BACKUP_STORE_URL=
# Local directory used when BACKUP_STORE_URL is empty.
BACKUP_DIR=.backups
# AES-256 passphrase for encrypted dumps. [prod-required] with backups enabled:
# `make backup` refuses to run without it.
BACKUP_PASSPHRASE=
# Retention: keep N daily snapshots and M monthly (first-of-month) snapshots.
BACKUP_RETENTION_DAILY=30
BACKUP_RETENTION_MONTHLY=12
# Static database URL to diff a restore against during `make restore-drill`
# (usually "production"). Empty = diff against DATABASE_URL.
BACKUP_SOURCE_URL=

# --- Reverse Proxy (Caddy) -------------------------------------------------
# Domain name for automatic HTTPS via Let's Encrypt.
# Set to your domain (e.g., cms.example.com) for production.
# Leave as "localhost" for local development with self-signed certs.
DOMAIN=localhost
# Email for Let's Encrypt registration (required for production domains).
# Leave empty for localhost/self-signed.
CADDY_EMAIL=

# --- Embed Configuration ---------------------------------------------------
# Comma-separated list of origins allowed to embed the CMS via the embed script.
# Example: EMBED_ORIGINS=https://example.com,https://www.example.com
# Empty = deny all (secure default). Must be set to enable embedding.
EMBED_ORIGINS=
# Scope granted to embed tokens. Must be a read-only scope.
# Currently only "posts:read" is supported for embed tokens.
EMBED_TOKEN_SCOPE=posts:read

# --- Version Pinning ---------------------------------------------------------
# Explicit immutable image tag or digest for production deployments.
# Examples: AGENTCMS_IMAGE_TAG=ghcr.io/owner/agentcms:v0.3.1
#           AGENTCMS_IMAGE_TAG=ghcr.io/owner/agentcms@sha256:abc123...
# [prod-required] In production this must be set to an immutable tag/digest.
# Mutable tags (latest, local, dev, major.minor only) are rejected.
AGENTCMS_IMAGE_TAG=
# --- Observability (optional self-hosted ops set, #47) ----------------------
# Prometheus + Alertmanager + Grafana + blackbox-exporter + container exporter:
# deploy/compose/docker-compose.observability.yml.  Attach it to the app stack's
# network with AGENTCMS_NETWORK=<docker compose project>_default.
AGENTCMS_NETWORK=
# [prod-required] if you run the ops set: Grafana admin password.
GRAFANA_ADMIN_PASSWORD=
# Free alert channel: no account needed on the public ntfy server.  Treat the
# topic name as a secret and keep credentials out of alert text (the rules only
# carry alert names, labels and the route that failed).
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
# Restrict the container exporter to this compose project, so a restart of an
# unrelated container on a shared host does not page you (empty = all containers).
EXPORT_PROJECT=
# Loopback ports for the ops set (override to avoid clashes).
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
ALERT_SINK_PORT=9119
DOCKER_EXPORTER_PORT=9121
BLACKBOX_PORT=9115
GRAFANA_PORT=3000
