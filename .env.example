# ---------------------------------------------------------------------------
# AgentCMS environment variables.  Copy to .env for local development:
#     cp .env.example .env
# Every variable the service reads is documented here. In `APP_ENV=production`
# the service refuses to boot while any variable marked [prod-required] is
# missing, and refuses to boot while any variable marked [dev-only default] is
# left at its default value.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
# development | test | production
APP_ENV=development
# Human-readable service name, echoed by /healthz and the OpenAPI document.
APP_NAME=AgentCMS
# Version reported by /healthz and /openapi.json.
APP_VERSION=0.3.0
# Log level for the structured logger: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO
# Serve GET /docs (Scalar), GET /redoc and GET /openapi.json. Keep true in prod:
# the generated spec IS the agent interface (#9).
DOCS_ENABLED=true
# Bind address for the dev server.
HOST=127.0.0.1
# Bind port for the dev server.  `make dev` prints http://$HOST:$PORT/docs.
PORT=8000
# Comma-separated CORS origins for browser clients. Empty = no CORS middleware.
CORS_ORIGINS=
# Enable debug mode. Must be false when APP_ENV=production.
DEBUG=false

# --- Security --------------------------------------------------------------
# SECRET_KEY signs session/token material. [prod-required] No working default
# in production: boot fails if it is missing, still the dev value, or < 32 chars.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-secret-change-me-please-000000000000

# --- Database --------------------------------------------------------------
# [prod-required] [dev-only default] SQLAlchemy URL. The dev default matches
# `docker compose up db` (see compose.yml).
DATABASE_URL=postgresql+psycopg://agentcms:agentcms@localhost:5432/agentcms
# Credentials consumed by compose.yml for the local Postgres container.
POSTGRES_USER=agentcms
POSTGRES_PASSWORD=agentcms
POSTGRES_DB=agentcms
POSTGRES_PORT=5432
# Connection pool sizing. [dev-only default: 5]
DB_POOL_SIZE=5
# Seconds to wait for a connection from the pool before failing readyz. [dev-only default: 5]
DB_POOL_TIMEOUT=5
# Echo SQL to stdout (development only).
DB_ECHO=false

# --- Object storage (S3-compatible; MinIO locally, see compose.yml) ---------
# Used by the media/asset endpoints (#20). Unset = media endpoints disabled.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=agentcms
S3_SECRET_ACCESS_KEY=agentcms-dev-secret
S3_BUCKET=agentcms-media
S3_REGION=us-east-1
# Public base URL media URLs are built from.
S3_PUBLIC_BASE_URL=http://localhost:9000/agentcms-media

# --- Content defaults ------------------------------------------------------
# Slug of the demo site created by `make seed`.
DEFAULT_SITE_SLUG=blog
# auto | require_review — publish_mode of the demo site (create never publishes).
DEFAULT_PUBLISH_MODE=auto
# How many idempotency-key responses are retained, in hours (#11).
IDEMPOTENCY_RETENTION_HOURS=24

# --- Capability links (#6) --------------------------------------------------
# Default lifetime of a link minted without an explicit TTL, in minutes.
CAPABILITY_DEFAULT_TTL_MINUTES=60
# Hard ceiling on a requested link TTL, in days.
CAPABILITY_MAX_TTL_DAYS=30
# Requests allowed per capability link within the window below.
CAPABILITY_RATE_LIMIT_PER_LINK=30
# Sliding rate-limit window, in seconds.
CAPABILITY_RATE_LIMIT_WINDOW_SECONDS=60
# Refuse to mint more than this many live links per site.
CAPABILITY_MAX_LIVE_LINKS_PER_SITE=100
